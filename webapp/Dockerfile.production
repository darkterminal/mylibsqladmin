FROM dunglas/frankenphp:1.4-php8.4-bookworm

ARG APP_ENV=production

# Environment variables
ENV APP_ENV=${APP_ENV} \
    FRANKENPHP_CONFIG="worker ./public/index.php" \
    FRANKENPHP_DOCUMENT_ROOT=/var/www/html/public \
    PHP_OPCACHE_ENABLE=1 \
    PHP_OPCACHE_VALIDATE_TIMESTAMPS=0

# Install system dependencies
RUN apt-get update && \
    apt-get install -y \
    git \
    curl \
    wget \
    unzip \
    libzip-dev \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libsqlite3-dev \
    libssh2-1-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory /var/www/html

# Install PHP extensions
ADD --chmod=0755 https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions /usr/local/bin/
RUN install-php-extensions \
    pdo \
    pdo_sqlite \
    mbstring \
    exif \
    pcntl \
    bcmath \
    gd \
    zip

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

# Install Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs

WORKDIR /var/www/html

# Copy application files — no .env inside the image; environment is provided
# at container runtime (compose env / docker run -e), never baked in.
COPY . .

RUN mkdir -p /var/www/html/database && \
    rm -rf public/build

# Install Turso PHP extension (pinned and hermetic).
# This intentionally avoids `turso-php-installer`: its release lookup goes
# through the GitHub API unauthenticated, which rate-limits shared CI egress
# IPs (observed: v1.6.1 build passed, v1.6.2 build failed with "API rate
# limit exceeded"). Instead, the exact release asset for this base image
# (PHP 8.4, ZTS/TS build for frankenphp worker mode) is downloaded directly.
# github.com/.../releases/download/... is not API-rate-limited.
# Bump TURSO_PHP_EXTENSION_TAG deliberately, in sync with the extension
# releases; keep PHP_VERSION_MM aligned with the base image.
ARG PHP_VERSION_MM=8.4
ARG TURSO_PHP_EXTENSION_TAG=turso-php-extension-v1.7.1
RUN set -eux; \
    ext_dir="$(php -r 'echo ini_get("extension_dir");')"; \
    asset="libsql_php-${TURSO_PHP_EXTENSION_TAG}-php-${PHP_VERSION_MM}-ts-x86_64-unknown-linux-gnu.tar.gz"; \
    curl -fsSL "https://github.com/tursodatabase/turso-client-php/releases/download/${TURSO_PHP_EXTENSION_TAG}/${asset}" -o /tmp/libsql.tar.gz; \
    mkdir -p /tmp/libsql; \
    tar -xzf /tmp/libsql.tar.gz -C /tmp/libsql --strip-components=1; \
    install -m 0755 /tmp/libsql/liblibsql_php.so "${ext_dir}/liblibsql_php.so"; \
    install -m 0644 /tmp/libsql/libsql_php_extension.stubs.php "${ext_dir}/libsql_php_extension.stubs.php"; \
    echo 'extension=liblibsql_php.so' > /usr/local/etc/php/conf.d/zz-libsql.ini; \
    php -m | grep -i libsql; \
    rm -rf /tmp/libsql /tmp/libsql.tar.gz

# Install dependencies
RUN composer install --optimize-autoloader --no-dev --no-interaction \
    && php artisan config:clear \
    && php artisan route:clear \
    && php artisan view:clear \
    && npm ci \
    && npm run build \
    && rm -f public/hot \
    && rm -rf node_modules /root/.npm

# Set permissions
RUN chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

# Entrypoint script
RUN mv entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["sh", "-c", "/usr/local/bin/docker-entrypoint.sh"]
