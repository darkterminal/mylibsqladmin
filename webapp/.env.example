APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# Enable only when diagnosing locally (never in production):
# APP_DEBUG=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=libsql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

# Reverse-proxy trust (v1.6.3+). Cloudflare edge ranges are always trusted.
# Enable private ranges when an internal proxy terminates TLS (Traefik/nginx).
TRUST_PRIVATE_PROXIES=false
# Comma-separated extra IPs/CIDRs, e.g. "10.0.0.0/8,203.0.113.7"
TRUSTED_PROXIES=

# Production server selection (v1.6.3+). "artisan" is the safe fallback while
# the FrankenPHP 1.4.4 / Octane 2.24 mismatch (F-60) is unresolved;
# "octane" is the explicit opt-in. Ignored when APP_ENV is not production.
WEB_SERVER=artisan

REGISTRATION_ENABLED=false

LIBSQL_LOCAL_INSTANCE=true

LIBSQL_HOST=db
LIBSQL_PORT=8080

# Client-facing parent domain for proxy subdomain routing + CSP.
# Leave empty for localhost. Example: example.com or example.co.uk.
# LIBSQL_PARENT_DOMAIN=

LIBSQL_API_HOST=db
LIBSQL_API_PORT=8081
LIBSQL_API_USERNAME=
LIBSQL_API_PASSWORD=

# Set to true to use HTTPS for sqld admin + metrics endpoint (production).
# LIBSQL_API_USE_HTTPS=true

# Geolocation lookups for auth-log/audit trail (disabled by default — IPs stay local).
GEOLOCATION_ENABLED=false


# Used only when WEB_SERVER=octane.
OCTANE_SERVER=frankenphp
