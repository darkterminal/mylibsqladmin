{
    "name": "darkterminal/libsql3",
    "description": "libsql3 CLI tool to interact with your MylibSQLAdmin",
    "type": "library",
    "license": "MIT",
    "bin": ["libsql3"],
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "Libsql3\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Libsql3\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Imam Ali Mustofa",
            "email": "d.darkterminal@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "psy/psysh": "^0.12.19"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "phpunit",
        "docs": "php bin/generate-cli-reference.php"
    }
}
